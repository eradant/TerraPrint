  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action in a region. A border and a glow, never a flood.",
      "html": "<button class=\"ds-btn-primary\">Generate model</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:7px 13px;border:1px solid var(--accent,#9184d9);border-radius:var(--radius,8px);background:transparent;color:var(--accent-bright,#b5abfc);font:500 12px Inter,sans-serif;cursor:pointer;transition:background .12s cubic-bezier(.2,.8,.2,1),color .12s cubic-bezier(.2,.8,.2,1)}.ds-btn-primary:hover{background:rgba(145,132,217,.12);color:var(--accent-text,#d2cefd)}.ds-btn-primary:active{background:rgba(145,132,217,.2)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent,#9184d9);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Everything that isn't the one action.",
      "html": "<button class=\"ds-btn\">All settings</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border:1px solid var(--line,#3f424d);border-radius:var(--radius,8px);background:transparent;color:var(--text-btn,#cfd3e5);font:500 12px Inter,sans-serif;cursor:pointer;transition:background .12s,border-color .12s}.ds-btn:hover{background:rgba(255,255,255,.03);border-color:var(--text-4,#75798c)}.ds-btn:active{background:rgba(145,132,217,.2)}.ds-btn:disabled{border-color:var(--line-soft,#292b31);color:var(--text-5,#595d6c);cursor:default}.ds-btn:focus-visible{outline:2px solid var(--accent,#9184d9);outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Place search, numeric fields, titles.",
      "html": "<input class=\"ds-input\" type=\"text\" value=\"Mount Rainier\">",
      "css": ".ds-input{width:220px;padding:7px 10px;background:var(--surface-2,#232532);border:1px solid var(--line,#3f424d);border-radius:var(--radius,8px);color:var(--text,#e9e9ed);font:400 12px Inter,sans-serif;outline:none;caret-color:var(--accent,#9184d9);transition:border-color .14s}.ds-input:hover{border-color:var(--text-4,#75798c)}.ds-input:focus{border-color:var(--accent,#9184d9)}.ds-input::placeholder{color:var(--text-4,#75798c);opacity:1}"
    },
    {
      "name": "Knob (slider with consequence)",
      "kind": "custom",
      "refersTo": null,
      "description": "The tray primitive. A slider is never bare: under it sits what the value costs.",
      "html": "<div class=\"ds-knob\"><div class=\"ds-knob-head\"><span class=\"ds-k-label\">Print size</span><span class=\"ds-k-val\">150 mm</span></div><input class=\"ds-range\" type=\"range\" min=\"50\" max=\"300\" value=\"150\"><div class=\"ds-knob-cap\">fits the 256 mm bed with 106 mm margin</div></div>",
      "css": ".ds-knob{min-width:220px}.ds-knob-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:7px}.ds-k-label{font:500 11px Inter,sans-serif;color:var(--text-2,#b2b6ca)}.ds-k-val{font:400 11px ui-monospace,Menlo,monospace;color:var(--text,#e9e9ed);font-variant-numeric:tabular-nums}.ds-knob-cap{font-size:10px;color:var(--text-4,#75798c);margin-top:6px}.ds-range{-webkit-appearance:none;appearance:none;width:100%;height:12px;background:transparent;cursor:pointer;--pct:40%}.ds-range::-webkit-slider-runnable-track{height:4px;border-radius:999px;background:linear-gradient(var(--accent,#9184d9),var(--accent,#9184d9)) 0/var(--pct) 100% no-repeat,var(--line,#3f424d)}.ds-range::-webkit-slider-thumb{-webkit-appearance:none;width:12px;height:12px;margin-top:-4px;border-radius:50%;background:var(--accent-bright,#b5abfc);box-shadow:0 0 8px rgba(145,132,217,.6);transition:transform .12s}.ds-range:hover::-webkit-slider-thumb{transform:scale(1.17);box-shadow:0 0 12px rgba(145,132,217,.75)}"
    },
    {
      "name": "Toggle",
      "kind": "custom",
      "refersTo": null,
      "description": "32x18 track, 14px knob at a 2px inset. The track fill is one of the four legitimate accent floods.",
      "html": "<label class=\"ds-tgl\"><input type=\"checkbox\" checked><span>Detect water</span><span class=\"ds-tgl-note\">2 mm deep</span></label>",
      "css": ".ds-tgl{display:flex;align-items:center;gap:9px;font:400 11.5px Inter,sans-serif;color:var(--text,#e9e9ed);cursor:pointer}.ds-tgl input{-webkit-appearance:none;appearance:none;width:32px;height:18px;border:none;border-radius:999px;background:radial-gradient(circle closest-side,var(--text-2,#b2b6ca) 0 90%,transparent 94%) left 2px center/14px 14px no-repeat,var(--line,#3f424d);cursor:pointer;flex:none;transition:background-color .16s,background-position .16s}.ds-tgl input:checked{background:radial-gradient(circle closest-side,var(--bg,#161826) 0 90%,transparent 94%) right 2px center/14px 14px no-repeat,var(--accent,#9184d9)}.ds-tgl input:focus-visible{outline:2px solid var(--accent,#9184d9);outline-offset:2px}.ds-tgl-note{margin-left:auto;font:400 10.5px ui-monospace,Menlo,monospace;color:var(--text-4,#75798c)}"
    },
    {
      "name": "Segmented Control",
      "kind": "chip",
      "refersTo": null,
      "description": "Two to four exclusive options. The active option is an accent fill with dark text.",
      "html": "<div class=\"ds-seg\"><button class=\"active\">8 &middot; 2 AMS</button><button>4 &middot; 1 AMS</button></div>",
      "css": ".ds-seg{display:inline-flex;border:1px solid var(--line,#3f424d);border-radius:var(--radius,8px);overflow:hidden}.ds-seg button{padding:6px 12px;background:transparent;border:none;font:500 11px Inter,sans-serif;color:var(--text-3,#9397ab);cursor:pointer;white-space:nowrap;transition:background .12s,color .12s}.ds-seg button+button{border-left:1px solid var(--line,#3f424d)}.ds-seg button:hover{background:rgba(255,255,255,.03);color:var(--text-2,#b2b6ca)}.ds-seg button.active{background:var(--accent,#9184d9);color:var(--bg,#161826)}"
    },
    {
      "name": "Viewport Badge",
      "kind": "chip",
      "refersTo": null,
      "description": "Names what a map or model half is showing, pinned 12px inside it.",
      "html": "<span class=\"ds-badge\">Print &middot; 4 filaments</span>",
      "css": ".ds-badge{display:inline-block;font:500 10px Inter,sans-serif;letter-spacing:.09em;text-transform:uppercase;color:var(--text-3,#9397ab);background:var(--bg,#161826);border:1px solid var(--line,#3f424d);border-radius:6px;padding:4px 8px;white-space:nowrap}"
    },
    {
      "name": "Filament Ledger",
      "kind": "card",
      "refersTo": null,
      "description": "The print consequence, always on screen. Mass share as a stacked bar in the real filament colors, then time and AMS changes.",
      "html": "<div class=\"ds-ledger\"><div class=\"ds-led-left\"><div class=\"ds-kicker\">Filament ledger</div><div class=\"ds-led-bar\"><span style=\"width:16%;background:#2d6abf\"></span><span style=\"width:34%;background:#c47f17\"></span><span style=\"width:29%;background:#3d8c40\"></span><span style=\"width:21%;background:#c8c8c8\"></span></div><div class=\"ds-led-masses\"><span>29 g water</span><span>63 g lowland</span><span>54 g forest</span><span>38 g alpine</span></div></div><div class=\"ds-led-right\"><div class=\"ds-led-figure\">9h 40m &middot; 1,842 changes</div><div class=\"ds-led-note\">watertight &middot; no floating parts</div></div></div>",
      "css": ".ds-ledger{display:flex;align-items:flex-end;gap:16px;padding:12px;background:#0f1017}.ds-led-left{flex:1;min-width:0}.ds-kicker{font:500 10px Inter,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--text-4,#75798c)}.ds-led-bar{display:flex;height:10px;border-radius:3px;overflow:hidden;margin-top:5px}.ds-led-masses{display:flex;flex-wrap:wrap;gap:4px 14px;margin-top:6px;font:400 10.5px ui-monospace,Menlo,monospace;color:var(--text-3,#9397ab);font-variant-numeric:tabular-nums}.ds-led-right{text-align:right;flex:none}.ds-led-figure{font:400 13px ui-monospace,Menlo,monospace;color:var(--text,#e9e9ed);font-variant-numeric:tabular-nums}.ds-led-note{font-size:10.5px;color:var(--text-4,#75798c);margin-top:3px}"
    },
    {
      "name": "Fading Rule",
      "kind": "custom",
      "refersTo": null,
      "description": "Every divider spanning a full frame fades out at both ends. Short marks stay solid.",
      "html": "<div class=\"ds-rule\"></div>",
      "css": ".ds-rule{height:1px;width:100%;background:linear-gradient(90deg,transparent,var(--line,#3f424d) 48px,var(--line,#3f424d) calc(100% - 48px),transparent)}"
    },
    {
      "name": "Format Radio Row",
      "kind": "custom",
      "refersTo": null,
      "description": "Export formats. The selected row is an accent tint with an accent border - one of the four legitimate fills.",
      "html": "<button class=\"ds-radio selected\"><span class=\"ds-rr-ring\"><i></i></span><span class=\"ds-rr-label\">3MF &mdash; color, per-object</span><span class=\"ds-rr-size\">&#8776;11 MB</span></button>",
      "css": ".ds-radio{display:flex;align-items:center;gap:10px;padding:9px 11px;border-radius:10px;background:var(--surface-2,#232532);border:1px solid transparent;cursor:pointer;width:100%;text-align:left;font-family:Inter,sans-serif;transition:background .12s,border-color .12s}.ds-radio:hover{background:#2a2c3a}.ds-rr-ring{width:13px;height:13px;flex:none;border-radius:50%;border:1px solid var(--text-5,#595d6c);display:grid;place-items:center}.ds-rr-ring i{width:6px;height:6px;border-radius:50%;background:transparent}.ds-rr-label{flex:1;font:400 12px Inter,sans-serif;color:var(--text-2,#b2b6ca)}.ds-rr-size{font:400 10.5px ui-monospace,Menlo,monospace;color:var(--text-4,#75798c);font-variant-numeric:tabular-nums}.ds-radio.selected{background:var(--accent-tint,#2b2741);border-color:var(--accent,#9184d9)}.ds-radio.selected:hover{background:#2f2b48}.ds-radio.selected .ds-rr-ring{border-color:var(--accent-bright,#b5abfc)}.ds-radio.selected .ds-rr-ring i{background:var(--accent-bright,#b5abfc)}.ds-radio.selected .ds-rr-label{font-weight:500;color:var(--text,#e9e9ed)}"
    }
  ],
  "narrative": {
    "northStar": "Nocturne",
    "overview": "A dark instrument ground with one blurple accent, carried as line and glow and almost never as a flood. The app is a workbench for a machine that makes a physical object, so the chrome recedes and two things stay loud: the terrain, and what printing it will cost.\n\nThe layout is a split bench. The map half and the model half sit side by side, permanently, separated by a single hairline the container paints. Under them, a 186px tabbed tray holds the knobs that change the print. Everything else lives behind an All settings drawer. The user never has to open a panel to find out what their model weighs.",
    "keyCharacteristics": [
      "Split bench: map and model side by side, permanently",
      "One blurple accent, carried as line and glow",
      "The print consequence is always on screen",
      "Every knob states its cost in the units the user cares about",
      "Inter 400/500 only; mono with tabular numerals for every compared figure",
      "Radii 8/10/14px; 999px is for toggle and slider tracks only"
    ],
    "rules": [
      {
        "name": "Line, not flood",
        "section": "colors",
        "body": "The accent is a 1px border, a 4px slider fill, a 2px tab underline, a thumb glow. The only accent fills in the whole app are the active segmented option, the selected radio row, the open All-settings button, and a toggle track when it is on."
      },
      {
        "name": "The ledger is always on",
        "section": "elevation",
        "body": "Weight, time and AMS changes render in the model half, not in a collapsed card. Every figure comes from one printEstimate object, so the ledger and the export dialog can never disagree."
      },
      {
        "name": "Every knob states its cost",
        "section": "typography",
        "body": "A slider is never bare: under it sits what it costs in the units the user cares about - millimetres of bed margin, triangles, megabytes, layers."
      },
      {
        "name": "Elevation is an edge plus darkness",
        "section": "elevation",
        "body": "One inset hairline ring and one soft shadow. Never a stack of shadows, never a glow used as depth."
      },
      {
        "name": "The data is not the theme",
        "section": "colors",
        "body": "Filament hexes and poster ink are real-world values. They never take a token and never re-theme."
      },
      {
        "name": "The fading rule",
        "section": "elevation",
        "body": "Every divider spanning a full frame fades out at both ends: 48px inset across the app frame, 16-24px inside a panel using --line-soft. Short marks - the 2px active-tab underline, a selected-row bar - stay solid. The fade is for rules, not marks."
      }
    ],
    "dos": [
      "Keep the map and the model on screen together. That pairing is the product.",
      "Put the print consequence where the model is, not behind a disclosure.",
      "Give every slider a consequence caption. A number with no unit of cost teaches nothing.",
      "Use mono + tabular numerals for anything a user will compare between runs.",
      "Let the drawer batch its edits and say how many are pending. Tray knobs apply on release; drawer edits apply on Apply.",
      "Re-theme third-party chrome (Leaflet controls, attribution, popups). Default widgets on this ground read as a bug.",
      "Mark the mesh stale when a geometry knob moves: dim the model, glow Regenerate, grey the ledger figures. Never auto-regenerate - the explicit Generate step is correct."
    ],
    "donts": [
      "Don't flood the accent. If a surface is blurple, it had better be one of the four fills named above.",
      "Don't add a second action color, and don't use color alone to carry state.",
      "Don't theme the filament hexes or the poster ink. They are data and print.",
      "Don't use 999px on a button, or 24px on a card. Those were the old system.",
      "Don't push Inter into the poster sheet. It prints in serif and Helvetica for a reason.",
      "Don't stack shadows to fake depth on a dark ground.",
      "Don't reach for a spinner where a progress line on the thing being rebuilt would do."
    ]
  }
}